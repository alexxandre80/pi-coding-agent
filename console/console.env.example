# Configuration de la Console DEV. Copié en console/console.env (chmod 600) par scripts/install.sh.

# Mot de passe (10 caractères minimum). L'identifiant est libre.
DEVCONSOLE_PASSWORD=

# IP Tailscale de la machine (commande : tailscale ip -4). Jamais 0.0.0.0.
DEVCONSOLE_BIND=
DEVCONSOLE_PORT=8094

AGENT_DIR=/home/pi/pi-coding-agent/agent
WORKSPACE_DIR=/home/pi/workspace
BACKUP_DIR=/home/pi/backups
AGENT_CONTAINER=coding-agent

# Limite quotidienne des modèles gratuits OpenRouter pour un compte sans crédit
OPENROUTER_FREE_PER_DAY=50
