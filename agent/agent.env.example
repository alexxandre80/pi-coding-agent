# Secrets de l'agent. Copié en agent/agent.env (chmod 600) par scripts/install.sh.
# Collez chaque valeur juste après le signe =, sans espace ni guillemets. Ne committez JAMAIS agent.env.

GROQ_API_KEY=
OPENROUTER_API_KEY=

# Mot de passe de l'interface web (identifiant : opencode). Le conteneur refuse de démarrer s'il est vide.
OPENCODE_SERVER_PASSWORD=
